# Renders the encrypted credential files into /run/atlas before anything else starts.
# Type=oneshot + RemainAfterExit so dependent units see it as satisfied, and so a failed
# render blocks the whole target instead of letting services start without settings.
[Unit]
Description=Render ATLAS runtime credentials from sops
Before=atlas.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/atlas/scripts/render-credentials.sh
# The render reads the host age key and writes root-owned 0600 files.
User=root
