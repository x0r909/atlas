{
  "include": [
    "packages",
    "services",
    "tests",
    "infra/db"
  ],
  "exclude": [
    "**/node_modules",
    "**/.venv",
    "apps/terminal-web/.next",
    "infra/db/versions/**/__pycache__"
  ],
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "typeCheckingMode": "basic",
  "extraPaths": [
    "packages/common",
    "packages/schemas",
    "services/execution",
    "services/api-gateway",
    "services/ingest-market",
    "services/ingest-news",
    "services/feature-engine",
    "services/risk-engine"
  ],
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none",
  "venvPath": ".",
  "venv": ".venv"
}
