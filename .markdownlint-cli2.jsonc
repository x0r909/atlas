{
  // Docs are read in a 100-column terminal, same budget as ruff (see pyproject.toml).
  "config": {
    "default": true,
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false,
      "headings": false
    },
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    // Spec Kit documents use bold labels as block markers on purpose.
    "MD036": false,
    "MD032": false
  },
  // `specs/**` is governed by the Spec Kit templates, not by this repo's prose rules;
// linting it would mean reformatting generated artefacts on every regeneration.
  "ignores": ["**/node_modules/**", "**/.venv/**", ".git/**", ".atl/**", ".pi/**", ".specify/**", "specs/**", "apps/terminal-web/.next/**"]
}
